<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UxPlay Mirror Toolbar" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}" UseLayoutRounding="True">
  <Border Margin="12" CornerRadius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}"
          BorderThickness="1" Padding="5">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.28"/>
    </Border.Effect>
    <StackPanel>
      <Border x:Name="TbFpsBox" CornerRadius="7" Background="{DynamicResource SurfaceAlt}" Margin="1,1,1,4" Padding="0,3"
              Visibility="Collapsed" ToolTip="เฟรมต่อวินาทีที่ iPhone ส่งมาจริง">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock x:Name="TbFps" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="TbFpsUnit" Text="FPS" FontSize="8.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,-2,0,0"/>
        </StackPanel>
      </Border>
      <Button x:Name="TbShot" Style="{StaticResource ToolBtn}" Content="&#xE722;" ToolTip="ถ่ายภาพหน้าจอ (Ctrl+Alt+S)"/>
      <Button x:Name="TbRec" Style="{StaticResource ToolBtn}" Content="&#xE7C8;" ToolTip="เริ่มบันทึกวิดีโอ (Ctrl+Alt+R)"/>
      <TextBlock x:Name="TbRecTime" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                 Foreground="{DynamicResource Danger}" Visibility="Collapsed" Margin="0,-2,0,3"/>
      <Button x:Name="TbDraw" Style="{StaticResource ToolBtn}" Content="&#xE70F;" ToolTip="ปากกาวาดบนจอ (Ctrl+Alt+D)"/>
      <Button x:Name="TbFull" Style="{StaticResource ToolBtn}" Content="&#xE740;" ToolTip="เต็มจอ (F11 หรือ Ctrl+Alt+F)"/>
      <Button x:Name="TbPin" Style="{StaticResource ToolBtn}" Content="&#xE718;" ToolTip="ปักหมุดไว้บนสุด"/>
      <Border Height="1" Margin="8,4" Background="{DynamicResource Stroke}"/>
      <Button x:Name="TbFolder" Style="{StaticResource ToolBtn}" Content="&#xE838;" ToolTip="เปิดโฟลเดอร์ภาพและวิดีโอ"/>
      <Button x:Name="TbHome" Style="{StaticResource ToolBtn}" Content="&#xE80F;" ToolTip="เปิดหน้าต่าง UxPlay Mirror"/>
    </StackPanel>
  </Border>
</Window>
