<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UxPlay Mirror" Width="1080" Height="700" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============ Sidebar ============ -->
    <Border Grid.Column="0" Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,20,12,24">
          <Image x:Name="LogoImage" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="UxPlay Mirror" FontSize="15.5" FontWeight="SemiBold"/>
            <TextBlock Text="แชร์จอ iPhone ขึ้นคอม" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
          </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" Padding="14,12" CornerRadius="10" Background="{DynamicResource SurfaceAlt}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="SideDot" Width="8" Height="8" VerticalAlignment="Center"/>
              <TextBlock x:Name="SideStatus" Margin="9,0,0,0" FontWeight="SemiBold" FontSize="12.5"/>
            </StackPanel>
            <TextBlock x:Name="SideDetail" FontSize="11.5" Margin="17,3,0,0" Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>

        <StackPanel>
          <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="หน้าหลัก" IsChecked="True"/>
          <RadioButton x:Name="NavMedia" Style="{StaticResource NavItem}" Tag="&#xE8B9;" Content="ภาพและวิดีโอ"/>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="ตั้งค่า"/>
          <RadioButton x:Name="NavHelp" Style="{StaticResource NavItem}" Tag="&#xE897;" Content="ตรวจสอบและช่วยเหลือ"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ Content ============ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnMin" Style="{StaticResource CaptionBtn}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="ย่อ"/>
        <Button x:Name="BtnMax" Style="{StaticResource CaptionBtn}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="ขยาย"/>
        <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="ปิด"/>
      </StackPanel>

      <Grid Grid.Row="1">

        <!-- ===== HOME ===== -->
        <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="34,0,34,30" MaxWidth="1000">

            <Border Style="{StaticResource Card}" Padding="30,28">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Width="140" Height="140" VerticalAlignment="Center">
                  <Ellipse x:Name="PulseRing" StrokeThickness="2" Stroke="{DynamicResource Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                      <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <Button x:Name="PowerButton" Style="{StaticResource PowerBtn}">
                    <TextBlock x:Name="PowerGlyph" Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="38"/>
                  </Button>
                </Grid>

                <StackPanel Grid.Column="1" Margin="30,0,24,0" VerticalAlignment="Center">
                  <Border x:Name="StatusPill" HorizontalAlignment="Left" CornerRadius="11" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"/>
                      <TextBlock x:Name="StatusPillText" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <TextBlock x:Name="StatusTitle" Style="{StaticResource H1}" FontSize="27" Margin="0,12,0,0" TextWrapping="Wrap"/>
                  <TextBlock x:Name="StatusDetail" Style="{StaticResource Muted}" FontSize="13.5" Margin="0,6,0,0"/>
                  <WrapPanel Margin="0,18,0,0">
                    <Border CornerRadius="8" Padding="12,7" Background="{DynamicResource SurfaceAlt}" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EA;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="ชื่อบน iPhone" Margin="8,0,0,0" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServerNameText" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <Border x:Name="PinChip" CornerRadius="8" Padding="12,7" Background="{DynamicResource AccentSoft}" Margin="0,0,8,8" Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="รหัส PIN" Margin="8,0,0,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PinText" Margin="8,0,0,0" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <Button x:Name="NowPlayingBtn" Style="{StaticResource PrimaryBtn}" Padding="12,7" Margin="0,0,8,8" Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="13"/>
                        <TextBlock Text="เปิดหน้าจอเพลง" Margin="8,0,0,0"/>
                      </StackPanel>
                    </Button>
                    <Border x:Name="QualityChip" CornerRadius="8" Padding="12,7" Background="{DynamicResource SurfaceAlt}" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="QualityText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </WrapPanel>
                </StackPanel>

                <Grid Grid.Column="2" Width="112" Height="208" VerticalAlignment="Center" Margin="0,0,6,0">
                  <Border CornerRadius="24" BorderThickness="5" BorderBrush="{DynamicResource PhoneFrame}" Background="{DynamicResource PhoneFrame}">
                    <Border x:Name="PhoneScreen" CornerRadius="19" Background="{DynamicResource SurfaceAlt}">
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="PhoneGlyph" Text="&#xE8EA;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="PhoneLabel" FontSize="11" Margin="8,8,8,0" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMuted}"/>
                      </StackPanel>
                    </Border>
                  </Border>
                  <Border Width="36" Height="9" CornerRadius="4.5" Background="{DynamicResource PhoneFrame}" VerticalAlignment="Top" Margin="0,10,0,0"/>
                </Grid>
              </Grid>
            </Border>

            <Border x:Name="RecBanner" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="12" Padding="18,10" Background="{DynamicResource DangerSoft}">
              <DockPanel>
                <Button x:Name="RecBannerStop" DockPanel.Dock="Right" Style="{StaticResource DangerBtn}" Padding="14,7">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}" FontSize="12"/>
                    <TextBlock Text="หยุดบันทึก" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{DynamicResource Danger}"/>
                  <TextBlock x:Name="RecBannerText" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <TextBlock Text="เชื่อมต่อใน 3 ขั้นตอน" Style="{StaticResource H2}" Margin="2,28,0,12"/>
            <UniformGrid Columns="3">
              <Border Style="{StaticResource Card}" Margin="0,0,7,0" Padding="20,18">
                <StackPanel>
                  <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent}"/>
                  </Border>
                  <TextBlock Text="1  ใช้ Wi-Fi เดียวกัน" Style="{StaticResource H2}" FontSize="14" Margin="0,14,0,5"/>
                  <TextBlock x:Name="Step1Desc" Style="{StaticResource Muted}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="7,0,7,0" Padding="20,18">
                <StackPanel>
                  <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE8EA;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent}"/>
                  </Border>
                  <TextBlock Text="2  เปิดการสะท้อนหน้าจอ" Style="{StaticResource H2}" FontSize="14" Margin="0,14,0,5"/>
                  <TextBlock Style="{StaticResource Muted}" Text="ปัดลงจากมุมขวาบนของ iPhone เพื่อเปิดศูนย์ควบคุม แล้วแตะไอคอน “การสะท้อนหน้าจอ” (Screen Mirroring)"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="7,0,0,0" Padding="20,18">
                <StackPanel>
                  <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent}"/>
                  </Border>
                  <TextBlock Text="3  เลือกคอมเครื่องนี้" Style="{StaticResource H2}" FontSize="14" Margin="0,14,0,5"/>
                  <TextBlock x:Name="Step3Desc" Style="{StaticResource Muted}"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <TextBlock Text="เครื่องมือระหว่างแชร์จอ" Style="{StaticResource H2}" Margin="2,28,0,12"/>
            <UniformGrid Columns="5">
              <Button x:Name="ActShot" Style="{StaticResource Tile}" Margin="0,0,7,0">
                <StackPanel>
                  <TextBlock Text="&#xE722;" Style="{StaticResource TileGlyph}"/>
                  <TextBlock Text="ถ่ายภาพหน้าจอ" Style="{StaticResource TileText}"/>
                </StackPanel>
              </Button>
              <Button x:Name="ActRec" Style="{StaticResource Tile}" Margin="7,0,7,0">
                <StackPanel>
                  <TextBlock x:Name="ActRecGlyph" Text="&#xE7C8;" Style="{StaticResource TileGlyph}"/>
                  <TextBlock x:Name="ActRecText" Text="บันทึกวิดีโอ" Style="{StaticResource TileText}"/>
                </StackPanel>
              </Button>
              <Button x:Name="ActDraw" Style="{StaticResource Tile}" Margin="7,0,7,0">
                <StackPanel>
                  <TextBlock x:Name="ActDrawGlyph" Text="&#xE70F;" Style="{StaticResource TileGlyph}"/>
                  <TextBlock x:Name="ActDrawText" Text="ปากกาวาด" Style="{StaticResource TileText}"/>
                </StackPanel>
              </Button>
              <Button x:Name="ActFull" Style="{StaticResource Tile}" Margin="7,0,7,0">
                <StackPanel>
                  <TextBlock x:Name="ActFullGlyph" Text="&#xE740;" Style="{StaticResource TileGlyph}"/>
                  <TextBlock x:Name="ActFullText" Text="เต็มจอ" Style="{StaticResource TileText}"/>
                </StackPanel>
              </Button>
              <Button x:Name="ActPin" Style="{StaticResource Tile}" Margin="7,0,0,0">
                <StackPanel>
                  <TextBlock x:Name="ActPinGlyph" Text="&#xE718;" Style="{StaticResource TileGlyph}"/>
                  <TextBlock x:Name="ActPinText" Text="ปักหมุดไว้บนสุด" Style="{StaticResource TileText}"/>
                </StackPanel>
              </Button>
            </UniformGrid>
            <TextBlock x:Name="ToolsHint" Style="{StaticResource Muted}" Margin="2,12,0,0"/>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== MEDIA ===== -->
        <Grid x:Name="PageMedia" Visibility="Collapsed" Margin="34,0,34,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="MediaRefresh" Style="{StaticResource Btn}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13"/>
                  <TextBlock Text="รีเฟรช" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="MediaOpenFolder" Style="{StaticResource PrimaryBtn}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="13"/>
                  <TextBlock Text="เปิดโฟลเดอร์" Margin="8,0,0,0"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="ภาพและวิดีโอ" Style="{StaticResource H1}"/>
              <TextBlock x:Name="MediaFolderText" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="MediaPanel"/>
          </ScrollViewer>
          <StackPanel x:Name="MediaEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,60">
            <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoft}">
              <TextBlock Text="&#xE8B9;" Style="{StaticResource Glyph}" FontSize="32" Foreground="{DynamicResource Accent}"/>
            </Border>
            <TextBlock Text="ยังไม่มีภาพหรือวิดีโอ" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
            <TextBlock Text="ระหว่างแชร์จอ กดถ่ายภาพหน้าจอหรือบันทึกวิดีโอ แล้วไฟล์จะมาแสดงที่นี่" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- ===== SETTINGS ===== -->
        <Grid x:Name="PageSettings" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsPanel" Margin="34,0,34,24" MaxWidth="880"/>
          </ScrollViewer>
          <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="34,12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SettingsReset" Style="{StaticResource Btn}" Content="คืนค่าเริ่มต้น" Margin="0,0,8,0"/>
                <Button x:Name="SettingsSave" Style="{StaticResource PrimaryBtn}" Content="บันทึกการตั้งค่า" Padding="20,8"/>
              </StackPanel>
              <TextBlock x:Name="SettingsNote" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </DockPanel>
          </Border>
        </Grid>

        <!-- ===== HELP ===== -->
        <ScrollViewer x:Name="PageHelp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="34,0,34,30" MaxWidth="920">
            <TextBlock Text="ตรวจสอบและช่วยเหลือ" Style="{StaticResource H1}"/>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="RecheckBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13"/>
                      <TextBlock Text="ตรวจอีกครั้ง" Margin="8,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <StackPanel>
                    <TextBlock Text="ตรวจความพร้อมของระบบ" Style="{StaticResource H2}"/>
                    <TextBlock Text="ถ้า iPhone มองไม่เห็นคอม ให้ดูรายการที่เป็นสีส้มหรือสีแดง" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                  </StackPanel>
                </DockPanel>
                <StackPanel x:Name="ChecksPanel" Margin="0,16,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="แก้ปัญหาที่พบบ่อย" Style="{StaticResource H2}"/>
                <StackPanel x:Name="TipsPanel" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="LogCopy" Style="{StaticResource Btn}" Margin="0,0,8,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13"/>
                        <TextBlock Text="คัดลอก" Margin="8,0,0,0"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="LogOpen" Style="{StaticResource Btn}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="13"/>
                        <TextBlock Text="เปิดโฟลเดอร์ log" Margin="8,0,0,0"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="บันทึกการทำงาน" Style="{StaticResource H2}"/>
                    <TextBlock Text="ข้อความจาก UxPlay ใช้ดูสาเหตุเวลามีปัญหา" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                  </StackPanel>
                </DockPanel>
                <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" Height="240" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <DockPanel>
                <Button x:Name="UpdateBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13"/>
                    <TextBlock Text="อัปเดต UxPlay" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
                <StackPanel>
                  <TextBlock Text="เกี่ยวกับ" Style="{StaticResource H2}"/>
                  <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" Margin="0,4,16,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Snackbar -->
      <Border x:Name="Snack" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
              CornerRadius="10" Padding="16,11" Background="{DynamicResource SnackBg}" Visibility="Collapsed" Opacity="0">
        <Border.Effect>
          <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.28"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="SnackIcon" Style="{StaticResource Glyph}" Foreground="{DynamicResource SnackFg}"/>
          <TextBlock x:Name="SnackText" Margin="10,0,0,0" Foreground="{DynamicResource SnackFg}" VerticalAlignment="Center"/>
          <Button x:Name="SnackAction" Style="{StaticResource LinkBtn}" Margin="18,0,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
