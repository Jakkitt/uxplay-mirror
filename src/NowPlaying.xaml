<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="กำลังเล่น – UxPlay Mirror" Width="420" Height="640" MinWidth="340" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#0E0F13" Foreground="White"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <!-- caption-button hover that works on the dark background in both app themes -->
    <SolidColorBrush x:Key="Hover" Color="#26FFFFFF"/>
  </Window.Resources>
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid ClipToBounds="True">
    <!-- blurred album art fills the background -->
    <Image x:Name="BgArt" Stretch="UniformToFill" Margin="-80" Opacity="0.7">
      <Image.Effect>
        <BlurEffect Radius="80" KernelType="Gaussian"/>
      </Image.Effect>
    </Image>
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#66000000" Offset="0"/>
          <GradientStop Color="#99000000" Offset="0.55"/>
          <GradientStop Color="#E6000000" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="16,0,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="NpPin" Style="{StaticResource CaptionBtn}" Foreground="White" FontSize="12" Content="&#xE718;"
                  WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="ปักหมุดไว้บนสุด"/>
          <Button x:Name="NpClose" Style="{StaticResource CloseBtn}" Foreground="White" Content="&#xE8BB;"
                  WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="ปิด"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
          <TextBlock x:Name="SourceText" Margin="8,0,0,0" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>

      <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="34,0,34,30">
        <Grid x:Name="ArtFrame" Width="290" Height="290" HorizontalAlignment="Center">
          <Grid.Effect>
            <DropShadowEffect BlurRadius="44" ShadowDepth="10" Opacity="0.55"/>
          </Grid.Effect>
          <Border x:Name="ArtPlaceholder" CornerRadius="18">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3B82F6" Offset="0"/>
                <GradientStop Color="#8B5CF6" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="84" Opacity="0.9"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border x:Name="ArtImage" CornerRadius="18" Visibility="Collapsed"/>
        </Grid>

        <TextBlock x:Name="TitleText" FontSize="23" FontWeight="SemiBold" Margin="0,30,0,0" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="ArtistText" FontSize="15.5" Margin="0,6,0,0" Opacity="0.85" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="AlbumText" FontSize="13" Margin="0,3,0,0" Opacity="0.55" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>

        <Grid Margin="0,28,0,0">
          <Border Height="5" CornerRadius="2.5" Background="#33FFFFFF"/>
          <Border x:Name="ProgressFill" Height="5" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0"/>
        </Grid>
        <DockPanel Margin="0,8,0,0">
          <TextBlock x:Name="RemainText" DockPanel.Dock="Right" FontSize="12" Opacity="0.65"/>
          <TextBlock x:Name="PosText" FontSize="12" Opacity="0.65"/>
        </DockPanel>

        <Border x:Name="PausedChip" HorizontalAlignment="Center" Margin="0,18,0,0" CornerRadius="11" Padding="12,4"
                Background="#26FFFFFF" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="หยุดชั่วคราว" FontSize="12" Margin="7,0,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock Text="เล่น หยุด หรือข้ามเพลงได้จาก iPhone" FontSize="11.5" Opacity="0.45" Margin="0,18,0,0" TextAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
